# Aroha Flow – environment variables
# Copy this file to .env and fill in your values. Do not commit .env.

# Data source: "local" (browser localStorage, no backend) or "production" (Supabase)
VITE_DATA_SOURCE=local

# Required when VITE_DATA_SOURCE=production (from Supabase project: Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: for "Add Recipe with AI" (URL parsing) in Meal Planning
OPENAI_API_KEY=

# Daily-driver OS UI → Agent Service localhost HTTP (#32).
# Default for local use with `npm run dev:os`. Comment out / unset for fixture-backed portfolio preview.
# If 8787 is already taken on your machine, pick another loopback port and set the same port in `.env.agent` (`AROHAFLOW_AGENT_HTTP_PORT`).
VITE_AGENT_HTTP_URL=http://127.0.0.1:8787

# --- Agent Service only (copy these into .env.agent; never into Vite / never VITE_*) ---
# AROHAFLOW_SUPABASE_URL=
# AROHAFLOW_SUPABASE_SERVICE_ROLE_KEY=
# AROHAFLOW_GOOGLE_CLIENT_ID=
# AROHAFLOW_GOOGLE_CLIENT_SECRET=
# AROHAFLOW_GOOGLE_REFRESH_TOKEN=
# AROHAFLOW_GOOGLE_CALENDAR_ID=
# AROHAFLOW_AGENT_HTTP_HOST=127.0.0.1
# AROHAFLOW_AGENT_HTTP_PORT=8787
# AROHAFLOW_AGENT_HTTP_CORS=http://localhost:5173
